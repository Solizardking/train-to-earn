{
  "name": "train2earn-solana",
  "version": "1.0.0",
  "description": "Solana Train-to-Earn Platform with AI-powered transaction analysis",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "smoke:rpc": "node scripts/smoke-rpc.mjs",
    "check:registry": "node scripts/check-registry-readiness.mjs",
    "check:solana-lora": "node scripts/inspect-solana-clawd-lora.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "anchor:keys": "anchor keys list",
    "anchor:sync": "anchor keys sync",
    "anchor:build": "anchor build",
    "anchor:deploy:devnet": "anchor deploy --provider.cluster https://api.devnet.solana.com",
    "anchor:deploy:mainnet": "anchor deploy --provider.cluster https://api.mainnet-beta.solana.com",
    "verify": "npm test && npm run check:registry && npm run check:docs && npm run build",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@metaplex-foundation/js": "^0.20.1",
    "@neondatabase/ai-sdk-provider": "^1.3.2",
    "ai": "^7.0.173",
    "@metaplex-foundation/mpl-agent-registry": "^0.2.6",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^1.5.1",
    "@pinecone-database/pinecone": "^6.1.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.95.8",
    "arweave": "^1.15.7",
    "axios": "^1.7.9",
    "brotli-wasm": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ipfs-http-client": "^60.0.1",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "snarkjs": "^0.7.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.3"
  }
}
