# ──────────────────────────────────────────────
# Train2Earn – Environment Variables
# Copy this file to .env and fill in your values
# Never commit your actual .env file
# ──────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development
SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Solana / Helius ────────────────────────────
# Get a free key at https://helius.dev
# Server-side only. Do not expose Solana RPC values with VITE_ prefixes.
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=

# ── AI Providers ──────────────────────────────
# OpenRouter (required for AI analysis)  https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# xAI Grok (optional – powers the CLAWD file upload agent)  https://x.ai
XAI_API_KEY=your_xai_api_key_here

# ── Storage ───────────────────────────────────
# Pinata IPFS pinning (optional)  https://pinata.cloud
PINATA_JWT=your_pinata_jwt_here
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# ── CLAWD Token (Solana SPL) ──────────────────
# These are public blockchain addresses — safe to use as-is
VITE_CLAWD_MINT=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
VITE_TREASURY_ADDRESS=EDCdUyLtCTjg2xC8VXLB2GmPPcVUNXrpDGEgQm8VATgk

# ── Clawd ZK Agent (optional) ─────────────────
CLAWD_ZK_RPC_URL=
CLAWD_ZK_PHOTON_URL=
CLAWD_ZK_NETWORK=mainnet
CLAWD_FREE_CHAT_URL=https://zk.x402.wtf/free
CLAWD_FREE_CHAT_API_URL=https://zk.x402.wtf/api/free/chat
METAPLEX_AGENT_API_BASE_URL=https://api.metaplex.com

# ── Local Clawd catalogs (optional, read-only discovery) ─
CLAWDBOT_SKILLS_DIR=/Users/8bit/skills/skills
CLAWDBOT_AGENTS_DIR=/Users/8bit/agents/agents/src
CLAWDBOT_ZK_PRIMITIVES_DIR=/Users/8bit/Agentics/clawdbot-go/zk-primitives

# ── Frontend (Vite) ───────────────────────────
VITE_API_URL=http://localhost:5001
VITE_ARWEAVE_GATEWAY=https://arweave.net
VITE_ARWEAVE_HOST=arweave.net
VITE_ARWEAVE_PORT=443
VITE_ARWEAVE_PROTOCOL=https
VITE_IPFS_GATEWAY=https://cloudflare-ipfs.com/ipfs/

# ── Hau Hau hosted inference (Musebook AI gateway, OpenAI-compatible) ──
# The Models page probes {VITE_HAUHAU_GATEWAY_URL}/models for
# VITE_HAUHAU_MODEL and enables its try-it panel only when the model is
# actually listed. Leave the API key empty until a gateway key is issued;
# without one the panel surfaces the gateway's own auth/payment response.
VITE_HAUHAU_GATEWAY_URL=https://gateway.musebook.trade/v1
VITE_HAUHAU_MODEL=clawd/hauhau-uncensored
VITE_HAUHAU_GATEWAY_API_KEY=

# ── Dynamic Auth (dynamic.xyz — optional wallet/JWT auth) ─
# Env ID, Org ID and JWKS are public identifiers (safe to commit).
# DYNAMIC_MIN_API_VERSION pins the environment to Dynamic's minimum
# API version. 2026_04_01 enforces the enhanced security requirements.
DYNAMIC_ENV_ID=76e0eab2-2432-4489-ba9c-b82291cb23b9
DYNAMIC_ORG_ID=70d020b8-3063-45d2-8221-0df3fd611f11
DYNAMIC_JWKS=https://app.dynamicauth.com/api/v0/sdk/76e0eab2-2432-4489-ba9c-b82291cb23b9/.well-known/jwks
DYNAMIC_MIN_API_VERSION=2026_04_01

# ── Phantom Server SDK (optional custodial wallets) ─
# Experimental/beta — requires partner access (partnerships@phantom.com) and
# `npm install @phantom/server-sdk`. Endpoints stay dormant (503) until all
# three are set. NEVER commit the real private key — server-side secret only.
PHANTOM_ORG_ID=your_phantom_organization_id
PHANTOM_PRIVATE_KEY=your_base58_org_private_key
PHANTOM_APP_ID=your_phantom_app_id

# ── Database (optional — falls back to in-memory) ─
# Render: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/traintoearn
DATABASE_SSL=false
